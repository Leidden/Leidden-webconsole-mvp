// User holds the self-managed account record. CloudStack Account is created
// at signup time and its handle/id is stored here for future API calls.
//
// Stage 1 only adds the User model. SshKey/Vm models follow in later stages.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  csAccountName String   @unique
  csDomainId    String
  csAccountId   String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
